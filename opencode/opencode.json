{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": false,
    "keep": {
      "tokens": 10000
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/deepseek-v4-flash-free",
  "experimental": {
    "todo": true
  },
  "mcp": {
    "servers": {
      "engram": {
        "type": "local",
        "command": [
          "C:/Users/Administrator/bin/engram.exe",
          "mcp",
          "--tools=agent"
        ]
      },
      "figma": {
        "type": "local",
        "command": [
          "figma-developer-mcp",
          "--stdio"
        ]
      },
      "composio-connect": {
        "type": "remote",
        "url": "https://connect.composio.dev/mcp",
        "headers": {
          "x-api-key": "{env:COMPOSIO_API_KEY}"
        }
      },
      "webshare-uk": {
        "type": "local",
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-WindowStyle",
          "Hidden",
          "-File",
          "C:/Users/Administrator/.config/opencode/scripts/run-webshare-mcp.ps1",
          "WS_HOST_UK",
          "WS_PORT_UK"
        ],
        "disabled": true
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": false
      },
      "canva": {
        "type": "remote",
        "url": "https://mcp.canva.com/mcp",
        "disabled": false
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "disabled": false
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp",
        "disabled": false
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com",
        "disabled": false
      },
      "webshare": {
        "type": "remote",
        "url": "https://mcp.webshare.io/",
        "disabled": false
      },
      "todoist": {
        "type": "remote",
        "url": "https://ai.todoist.net/mcp",
        "headers": {
          "Authorization": "Bearer {env:TODOIST_TOKEN}"
        },
        "disabled": false
      },
      "gitlab": {
        "type": "remote",
        "url": "https://gitlab.com/api/v4/mcp",
        "headers": {
          "Authorization": "Bearer {env:GITLAB_TOKEN}"
        },
        "disabled": false
      },
      "postman": {
        "type": "remote",
        "url": "https://mcp.postman.com/minimal",
        "headers": {
          "Authorization": "Bearer {env:POSTMAN_API_KEY}"
        },
        "disabled": false
      },
      "prisma-postgres": {
        "type": "remote",
        "url": "https://mcp.prisma.io/mcp",
        "headers": {
          "Authorization": "Bearer {env:PRISMA_TOKEN}"
        },
        "disabled": false
      },
      "rentahuman": {
        "type": "remote",
        "url": "https://rentahuman.ai/api/mcp",
        "headers": {
          "x-api-key": "{env:RENTAHUMAN_API_KEY}"
        },
        "disabled": false
      },
      "microsoft-learn": {
        "type": "remote",
        "url": "https://learn.microsoft.com/api/mcp",
        "disabled": false
      },
      "twilio-docs": {
        "type": "remote",
        "url": "https://mcp.twilio.com/docs",
        "disabled": false
      },
      "swissdevjobs": {
        "type": "local",
        "command": [
          "C:/Users/Administrator/.local/bin/swissdevjobs-mcp.exe"
        ],
        "environment": {
          "SDJ_NAME": "Diego Samuel Hardi Santana",
          "SDJ_EMAIL": "diegosamuel042@gmail.com",
          "SDJ_CV": "C:/Users/Administrator/mi_gdrive/Mi unidad/[Clase]/- Curriculum copium [+Certificados]/cv.pdf"
        },
        "disabled": false
      }
    }
  },
  "provider": {
    "google": {
      "options": {
        "apiKey": "{env:GOOGLE_API_KEY}",
        "projectId": "cic-ptd-dev"
      },
      "models": {
        "gemini-2.5-flash": {
          "options": {}
        },
        "gemini-2.5-pro": {
          "options": {}
        },
        "gemini-3-flash-preview": {
          "options": {}
        },
        "gemini-3-pro-preview": {
          "options": {}
        }
      }
    },
    "ollama": {
      "models": {
        "nemotron-3-super:cloud": {
          "name": "nemotron-3-super:cloud",
          "options": {}
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:OLLAMA_API_KEY}",
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "opencode": {
      "options": {}
    },
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    },
    "anthropic": {
      "options": {}
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPEN_ROUTER_API_KEY}"
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    },
    "copilot": {
      "options": {}
    }
  },
  "plugins": [
    "opencode-gemini-auth@latest",
    {
      "package": "C:/Users/Administrator/workspace/opencode-discord-rpc"
    }
  ]
}
