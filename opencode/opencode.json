          "WS_PORT_US_3"
        ],
        "disabled": true
      },
      "webshare-pl": {
        "type": "local",
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-WindowStyle",
          "Hidden",
          "-File",
          "C:/Users/Administrator/.config/opencode/scripts/run-webshare-mcp.ps1",
          "WS_HOST_PL",
          "WS_PORT_PL"
        ],
        "disabled": true
      },
      "webshare-us-4": {
        "type": "local",
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-WindowStyle",
          "Hidden",
          "-File",
          "C:/Users/Administrator/.config/opencode/scripts/run-webshare-mcp.ps1",
          "WS_HOST_US_4",
          "WS_PORT_US_4"
        ],
        "disabled": true
      },
      "webshare-us-5": {
        "type": "local",
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-WindowStyle",
          "Hidden",
          "-File",
          "C:/Users/Administrator/.config/opencode/scripts/run-webshare-mcp.ps1",
          "WS_HOST_US_5",
