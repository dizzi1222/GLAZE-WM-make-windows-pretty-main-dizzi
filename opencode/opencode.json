{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": false,
    "keep": {
      "tokens": 10000
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/deepseek-v4-flash-free",
  "mcp": {
    "servers": {
      "engram": {
        "type": "local",
        "command": [
          "C:/Users/Administrator/bin/engram.exe",
          "mcp",
          "--tools=agent"
        ],
        "disabled": false
      },
      "figma": {
        "type": "local",
        "command": [
          "figma-developer-mcp",
          "--figma-api-key={env:FIGMA_API_KEY}",
          "--stdio"
        ],
        "disabled": false
      },
      "composio-connect": {
        "type": "remote",
        "url": "https://connect.composio.dev/mcp",
        "headers": {
          "x-api-key": "{env:COMPOSIO_API_KEY}"
        },
        "disabled": false
      },
      "webshare-uk": {
        "type": "local",
        "command": [
          "node",
          "C:/Users/Administrator/workspace/dataimpulse-mcp/index.js"
        ],
        "environment": {
          "DI_USER": "{env:WS_USER}",
          "DI_PASS": "{env:WS_PASS}",
          "DI_PROXY_HOST": "{env:WS_HOST_UK}",
          "DI_PROXY_PORT": "{env:WS_PORT_UK}"
        },
        "disabled": false
      },
      "webshare-es": {
        "type": "local",
        "command": [
          "node",
          "C:/Users/Administrator/workspace/dataimpulse-mcp/index.js"
        ],
        "environment": {
          "DI_USER": "{env:WS_USER}",
          "DI_PASS": "{env:WS_PASS}",
          "DI_PROXY_HOST": "{env:WS_HOST_ES}",
          "DI_PROXY_PORT": "{env:WS_PORT_ES}"
        },
        "disabled": false
      },
      "webshare-us": {
        "type": "local",
        "command": [
          "node",
          "C:/Users/Administrator/workspace/dataimpulse-mcp/index.js"
        ],
        "environment": {
          "DI_USER": "{env:WS_USER}",
          "DI_PASS": "{env:WS_PASS}",
          "DI_PROXY_HOST": "{env:WS_HOST_US}",
          "DI_PROXY_PORT": "{env:WS_PORT_US}"
        },
        "disabled": false
      },
      "webshare-us-2": {
        "type": "local",
        "command": [
          "node",
          "C:/Users/Administrator/workspace/dataimpulse-mcp/index.js"
        ],
        "environment": {
          "DI_USER": "{env:WS_USER}",
