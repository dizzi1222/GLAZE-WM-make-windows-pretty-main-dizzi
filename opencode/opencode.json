{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": false,
    "keep": {
      "tokens": 10000
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/deepseek-v4-flash-free",
  "experimental": {
    "todo": true
  },
  "mcp": {
    "servers": {
      "engram": {
        "type": "local",
        "command": [
          "C:/Users/Administrator/bin/engram.exe",
          "mcp",
          "--tools=agent"
        ]
      },
      "figma": {
        "type": "local",
        "command": [
          "figma-developer-mcp",
          "--figma-api-key={env:FIGMA_API_KEY}",
          "--stdio"
        ]
      },
      "composio-connect": {
        "type": "remote",
        "url": "https://connect.composio.dev/mcp",
        "headers": {
          "x-api-key": "{env:COMPOSIO_API_KEY}"
        }
      },
      "webshare-uk": {
        "type": "local",
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-WindowStyle",
          "Hidden",
          "-File",
          "C:/Users/Administrator/.config/opencode/scripts/run-webshare-mcp.ps1",
          "WS_HOST_UK",
          "WS_PORT_UK"
        ],
        "disabled": false
      },
      "webshare-es": {
        "type": "local",
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-WindowStyle",
          "Hidden",
          "-File",
          "C:/Users/Administrator/.config/opencode/scripts/run-webshare-mcp.ps1",
          "WS_HOST_ES",
          "WS_PORT_ES"
        ],
        "disabled": false
      },
      "webshare-us": {
        "type": "local",
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-WindowStyle",
          "Hidden",
          "-File",
          "C:/Users/Administrator/.config/opencode/scripts/run-webshare-mcp.ps1",
          "WS_HOST_US",
          "WS_PORT_US"
        ],
        "disabled": true
      },
      "webshare-us-2": {
        "type": "local",
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-WindowStyle",
          "Hidden",
          "-File",
          "C:/Users/Administrator/.config/opencode/scripts/run-webshare-mcp.ps1",
          "WS_HOST_US_2",
          "WS_PORT_US_2"
        ],
        "disabled": true
      },
      "webshare-us-3": {
        "type": "local",
        "command": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-WindowStyle",
          "Hidden",
          "-File",
          "C:/Users/Administrator/.config/opencode/scripts/run-webshare-mcp.ps1",
